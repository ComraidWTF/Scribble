{
  // Standard Microsoft.Extensions.Logging filters. Changes apply while the API is running.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.AspNetCore": "Warning",
      // "Request starting GET /customers/1" + "Request finished ... 200 - 3.2 ms": one pair per request.
      // Set to "Warning" to turn request logging off.
      "Microsoft.AspNetCore.Hosting.Diagnostics": "Information",
      // App start/stop and "Now listening on: ..."
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },

  // File settings. Applied at startup.
  "FileLogging": {
    "Directory": "",   // empty = "logs" next to the executable; e.g. "D:\\Logs\\LogDemo-Api" in production
    "RetentionDays": 14,
    "MaxRetainedFiles": 100,
    "MaxFileSizeMB": 50
  },

  "AllowedHosts": "*"
}
