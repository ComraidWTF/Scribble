<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Drop into src/ next to the WPF apps; versions come from the repo's Directory.Packages.props. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <RootNamespace>LogDemo.Api</RootNamespace>
  </PropertyGroup>

  <!-- The same four Serilog packages LogDemo.Logging already uses; nothing new to add. -->
  <ItemGroup>
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Enrichers.Thread" />
  </ItemGroup>

</Project>
